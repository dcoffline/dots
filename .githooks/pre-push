#!/usr/bin/env bash
# Pre-push protection (2026-10-13):
#  a) secret-scan outgoing commits for credential-bearing URLs
#  b) git-crypt gate: .secrets/*.secret/rclone.conf blobs MUST carry the
#     GITCRYPT magic — a plaintext secret blob never reaches GitHub.
# Runs under the containerized git; scanner lives IN the repo.
zero=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha^..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  [ -z "$range" ] && continue
  top="$(git rev-parse --show-toplevel)"
  SCANNER="$top/.githooks/secret_scan.py"
  # (a) secret scan
  if [ -f "$SCANNER" ]; then
    if ! git diff "$range" -U0 | /usr/bin/python3 "$SCANNER" --stdin; then
      echo "PUSH BLOCKED: credential-bearing content in $range"
      fail=1
    fi
  else
    echo "WARN: scanner missing ($SCANNER)" >&2
  fi
  # (b) git-crypt gate
  for p in $(git diff --name-only "$range" | grep -E '(^|/)\.secrets$|\.secret$|rclone\.conf$'); do
    if git cat-file -e "$local_sha:$p" 2>/dev/null; then
      magic=$(git cat-file blob "$local_sha:$p" 2>/dev/null | head -c 10 | tr -d '\0')
      case "$magic" in
        *GITCRYPT*) : ;;
        *) echo "PUSH BLOCKED: $p in $local_sha is NOT git-crypt encrypted (missing GITCRYPT magic)"
           fail=1 ;;
      esac
    fi
  done
done
exit $fail
