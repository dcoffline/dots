#!/usr/bin/env bash
# Pre-push secret scan (2026-10-13): scans OUTGOING commits for credential-
# bearing URLs (api_password, debrid keys, picker blobs, JWTs). Fails closed
# on findings, warns open if scanner missing.
SCANNER=/opt/data/scripts/dots_secret_scan.py
zero=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    diff_range="$local_sha^..$local_sha" 2>/dev/null || diff_range=""
  else
    diff_range="$remote_sha..$local_sha"
  fi
  [ -z "$diff_range" ] && continue
  if [ -x "$SCANNER" ]; then
    if ! git diff "$diff_range" -U0 | python3 "$SCANNER" --stdin; then
      echo "PUSH BLOCKED: credential-bearing content in outgoing commits ($diff_range)."
      fail=1
    fi
  else
    echo "WARN: secret scanner missing at $SCANNER; not scanned." >&2
  fi
done
exit $fail
