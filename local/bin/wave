#!/usr/bin/env bash

exec >/tmp/wave-gui.log 2>&1
set -x

export DESKTOPINTEGRATION=1
export DISPLAY=:0

# Use direct globbing instead of find — instantaneous and cannot recurse
for f in "/run/user/$(id -u)/"*Xwaylandauth*; do
    if [ -e "$f" ]; then
        export XAUTHORITY="$f"
        break
    fi
done

exec "${HOME}/Applications/wave.appimage" --ozone-platform=x11 --enable-transparent-visuals --ignore-gpu-blocklist
