#!/bin/bash

# Path to your local Logseq markdown directory
LOGSEQ_DIR="$HOME/src/logseq"

# Helper for showing desktop notifications (non-blocking)
notify() {
    local title="$1"
    local msg="$2"
    if command -v notify-send &>/dev/null; then
        notify-send -t 3000 "$title" "$msg"
    fi
}

# Helper for showing graphical error dialogs (blocking)
show_error() {
    local msg="$1"
    if command -v zenity &>/dev/null; then
        zenity --error --text="$msg" --title="Logseq Sync Error" --width=400
    else
        echo "❌ ERROR: $msg"
    fi
}

cd "$LOGSEQ_DIR" || exit

# Function to commit changes if any exist
commit_changes() {
    local stage="$1"
    # Check for modified, added, deleted, or untracked changes
    if [[ -n $(git status --porcelain) ]]; then
        echo "💾 Found uncommitted changes ($stage). Saving to Git..."
        git add -A
        git commit -m "Last Sync: $(date '+%Y-%m-%d %H:%M') ($stage)"
    else
        echo "✨ No uncommitted changes ($stage)."
    fi
}

# 1. Commit any local changes left over before pulling
commit_changes "Pre-sync: Local edits"

# 2. Pull down latest mobile changes from GitHub
notify "Logseq Sync" "🔄 Pulling down latest changes..."
echo "🔄 Pulling down latest mobile changes from GitHub..."
git pull origin main --rebase

# Check if rebase/pull succeeded. If there's a conflict, let the user know.
if [ $? -ne 0 ]; then
    show_error "⚠️ Conflict detected during git pull!\n\nPlease resolve the conflict manually in your terminal:\ncd $LOGSEQ_DIR\ngit status\n\nPress OK once resolved to launch Logseq."
fi

# 3. Launch Logseq (handling normal vs. Wayland launch)
echo "🚀 Launching Logseq..."
notify "Logseq Sync" "🚀 Launching Logseq..."

if [ "$1" = "--wayland" ]; then
    shift
    env DESKTOPINTEGRATION=1 /usr/bin/flatpak run --branch=stable --arch=x86_64 --command=run.sh --file-forwarding com.logseq.Logseq "$@" --enable-features=UseOzonePlatform --ozone-platform=wayland --enable-features=WaylandWindowDecorations
else
    env DESKTOPINTEGRATION=1 /usr/bin/flatpak run --branch=stable --arch=x86_64 --command=run.sh --file-forwarding com.logseq.Logseq "$@"
fi

# Give the system a brief moment to ensure all file writes are finalized
sleep 1

# 4. Logseq closed. Commit any new changes.
notify "Logseq Sync" "📦 Logseq closed. Saving changes..."
echo "📦 Logseq closed. Saving changes..."
commit_changes "Linux desktop sync"

# 5. Push the changes to GitHub
echo "🚀 Shipping latest commits to GitHub..."
git push origin main

if [ $? -eq 0 ]; then
    notify "Logseq Sync" "✅ Sync complete and pushed to GitHub!"
    echo "✅ Sync complete!"
else
    show_error "❌ Failed to push changes to GitHub.\n\nPlease check your network connection or repository status."
fi
