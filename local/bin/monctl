#!/bin/bash

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

# macOS support
if [[ "$OSTYPE" == darwin* ]]; then
  echo "monctl: invoked with '$*' (client: ${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT}@${SUNSHINE_CLIENT_FPS}) on $(uname -m)" >>"$HOME/.config/sunshine/sunshine_script.log"

  if [ -n "$1" ]; then
    RES="$1"
    REFRESH="${2:-60}"
  elif [ -n "$SUNSHINE_CLIENT_WIDTH" ] && [ -n "$SUNSHINE_CLIENT_HEIGHT" ]; then
    RES="${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT}"
    REFRESH="${SUNSHINE_CLIENT_FPS:-60}"
  else
    RES="2560x1440"
    REFRESH="60"
  fi

  # 1. Ensure BetterDisplay virtual screen is connected (never disconnect it)
  if command -v betterdisplaycli >/dev/null 2>&1; then
    betterdisplaycli set -nameLike="Remote Screen" -connected=on 2>/dev/null || true
  fi

  # 2. Arrange displays: Remote Screen as Main at (0,0), physical Dell display at (tw, th) corner
  if command -v displayplacer >/dev/null 2>&1; then
    python3 -c '
import subprocess, re, sys, time

target_res = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else "2560x1440"
try:
    tw, th = map(int, target_res.split("x"))
except Exception:
    tw, th = 2560, 1440

try:
    out = subprocess.check_output(["displayplacer", "list"], text=True)
    screens = out.split("Persistent screen id: ")
    virtual_id = None
    physical_id = None
    v_is_main = False
    v_cur_res = None
    p_cur_origin = None

    for s in screens[1:]:
        lines = s.splitlines()
        sid = lines[0].strip()
        if sid.startswith("0BDA5B94") or "s3546859106" in sid:
            virtual_id = sid
            v_is_main = any("main display" in l for l in lines)
            for line in lines:
                m = re.match(r"^Resolution:\s+(\d+x\d+)", line)
                if m:
                    v_cur_res = m.group(1)
        elif sid.startswith("8FF805E8") or "s1095512908" in sid:
            physical_id = sid
            for line in lines:
                m = re.match(r"^Origin:\s+(\([^)]+\))", line)
                if m:
                    p_cur_origin = m.group(1)

    if virtual_id and physical_id:
        if v_is_main and v_cur_res == target_res and p_cur_origin == f"({tw},{th})":
            # Already in desired state; ensure Dell brightness is 0 and exit immediately
            subprocess.run(["betterdisplaycli", "set", "-nameLike=DELL", "-brightness=0"], capture_output=True)
            sys.exit(0)

        # Set resolution on virtual screen via BetterDisplay
        subprocess.run(["betterdisplaycli", "set", "-nameLike=Remote Screen", f"-resolution={target_res}"], capture_output=True)

        # Arrange: Remote Screen at (0,0) as main display, Dell at (tw, th) corner
        cmd = ["displayplacer", f"id:{virtual_id} res:{target_res} origin:(0,0)", f"id:{physical_id} res:2560x1440 origin:({tw},{th})"]
        subprocess.check_call(cmd)
        subprocess.run(["betterdisplaycli", "set", "-nameLike=DELL", "-brightness=0"], capture_output=True)
        time.sleep(0.5)
    elif physical_id:
        subprocess.check_call(["displayplacer", f"id:{physical_id} res:{target_res} origin:(0,0)"])
except Exception as e:
    print(f"monctl error: {e}", file=sys.stderr)
' "$RES" "$REFRESH" 2>/dev/null
    exit 0
  fi
  exit 0
fi

MAIN="HDMI-1"
DUMMY="DP-6"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -z "$XDG_CURRENT_DESKTOP" ]; then
  if pgrep -x kwin_wayland >/dev/null 2>&1; then
    export XDG_CURRENT_DESKTOP="KDE"
  elif pgrep -x gnome-shell >/dev/null 2>&1; then
    export XDG_CURRENT_DESKTOP="GNOME"
  elif pgrep -x cosmic-comp >/dev/null 2>&1; then
    export XDG_CURRENT_DESKTOP="COSMIC"
  fi
fi

if [ -z "$WAYLAND_DISPLAY" ] || [ ! -S "${XDG_RUNTIME_DIR}/$WAYLAND_DISPLAY" ]; then
  for s in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
    if [ -S "$s" ]; then
      export WAYLAND_DISPLAY="$(basename "$s")"
      break
    fi
  done
fi
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

# Dynamically detect Flatpak or Toolbx/Distrobox containers
RUN=()
if [ -f /.flatpak-info ] || [ -f /run/.containerenv ]; then
  RUN=(flatpak-spawn --host --env=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" --env=XAUTHORITY="$XAUTHORITY")
fi

echo "Running as $XDG_CURRENT_DESKTOP on $WAYLAND_DISPLAY" >>"$HOME/.config/sunshine/sunshine_script.log"

if [ -n "$1" ]; then
  RES="$1"
  REFRESH="${2:-60}"
elif [ -n "$SUNSHINE_CLIENT_WIDTH" ] && [ -n "$SUNSHINE_CLIENT_HEIGHT" ]; then
  RES="${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT}"
  REFRESH="${SUNSHINE_CLIENT_FPS:-60}"
else
  RES="2560x1440"
  REFRESH="120"
fi
SCALE=${3:-1}

case "$XDG_CURRENT_DESKTOP" in
"KDE" | *"KDE"* | plasma)
  WIDTH=$(echo "$RES" | cut -d'x' -f1)
  HEIGHT=$(echo "$RES" | cut -d'x' -f2)
  FPS_INT=$(printf "%.0f" "$REFRESH" 2>/dev/null || echo 60)

  if "${RUN[@]}" kscreen-doctor --json 2>/dev/null | jq -e '.outputs[] | select(.name == "Virtual-sunshine-vmon")' >/dev/null 2>&1; then
    TARGET_OUT="Virtual-sunshine-vmon"
  else
    TARGET_OUT="$DUMMY"
  fi

  MODE_ID=$("${RUN[@]}" kscreen-doctor --json 2>/dev/null | jq -r --arg vmon "$TARGET_OUT" --argjson w "$WIDTH" --argjson h "$HEIGHT" --argjson fps "$FPS_INT" '
    .outputs[] | select(.name == $vmon) | .modes[] |
    select(.size.width == $w and .size.height == $h and ((.refreshRate - $fps) | fabs < 2)) | .id
  ' | head -n1)

  if [ -z "$MODE_ID" ] && [ "$TARGET_OUT" = "Virtual-sunshine-vmon" ]; then
    "${RUN[@]}" kscreen-doctor "output.${TARGET_OUT}.addCustomMode.${WIDTH}.${HEIGHT}.$((FPS_INT * 1000)).full"
    MODE_ID=$("${RUN[@]}" kscreen-doctor --json 2>/dev/null | jq -r --arg vmon "$TARGET_OUT" --argjson w "$WIDTH" --argjson h "$HEIGHT" --argjson fps "$FPS_INT" '
      .outputs[] | select(.name == $vmon) | .modes[] |
      select(.size.width == $w and .size.height == $h and ((.refreshRate - $fps) | fabs < 2)) | .id
    ' | head -n1)
  fi

  if [ -n "$MODE_ID" ]; then
    "${RUN[@]}" kscreen-doctor "output.${TARGET_OUT}.enable" "output.${TARGET_OUT}.mode.${MODE_ID}" "output.${TARGET_OUT}.scale.${SCALE}"
  else
    "${RUN[@]}" kscreen-doctor "output.${TARGET_OUT}.enable" "output.${TARGET_OUT}.mode.${RES}@${FPS_INT}" "output.${TARGET_OUT}.scale.${SCALE}" || true
  fi
  ;;
"COSMIC")
  WIDTH=$(echo "$RES" | cut -d'x' -f1)
  HEIGHT=$(echo "$RES" | cut -d'x' -f2)

  "${RUN[@]}" cosmic-randr mode --refresh "$REFRESH" "$DUMMY" "$WIDTH" "$HEIGHT"
  "${RUN[@]}" cosmic-randr mode --scale "$SCALE" "$DUMMY" "$WIDTH" "$HEIGHT"
  ;;
"GNOME" | *"GNOME"*)
  GNOME_DUMMY=$(echo "$DUMMY" | sed 's/-A-/-/g')

  # Force the script to talk to the active user's GNOME session
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

  # Resolve closest supported refresh rate for requested resolution
  MODE=$(python3 -c '
import subprocess, re, sys
connector = sys.argv[1]
target_res = sys.argv[2]
try:
    target_ref = float(sys.argv[3])
except (ValueError, IndexError):
    target_ref = 60.0

try:
    out = subprocess.check_output(["gdctl", "show", "-m"], text=True)
    lines = out.splitlines()
    in_mon = False
    modes = []
    for line in lines:
        if f"Monitor {connector}" in line:
            in_mon = True
        elif in_mon and "Monitor " in line:
            break
        elif in_mon:
            m = re.search(r"(\d+x\d+)@([\d.]+)", line)
            if m and m.group(1) == target_res:
                modes.append((float(m.group(2)), f"{m.group(1)}@{m.group(2)}"))
    if modes:
        modes.sort(key=lambda x: abs(x[0] - target_ref))
        print(modes[0][1])
except Exception:
    pass
' "$GNOME_DUMMY" "$RES" "$REFRESH" 2>/dev/null)

  TARGET_MODE="${MODE:-${RES}@${REFRESH}}"

  # Retry fallbacks so an unsupported client resolution never kills a
  # stream: exact -> bare (auto) -> 1440p -> 1080p. gdctl exits 1 with
  # "No mode ... available" when the client's requested mode is missing.
  "${RUN[@]}" gdctl set -L -p -M "$GNOME_DUMMY" -m "$TARGET_MODE" -s "$SCALE" \
    || "${RUN[@]}" gdctl set -L -p -M "$GNOME_DUMMY" \
    || "${RUN[@]}" gdctl set -L -p -M "$GNOME_DUMMY" -m 2560x1440@119.877 \
    || "${RUN[@]}" gdctl set -L -p -M "$GNOME_DUMMY" -m 1920x1080@119.877
  ;;
esac
