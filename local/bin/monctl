#!/bin/bash

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

# macOS support
if [[ "$OSTYPE" == darwin* ]]; then
  echo "monctl: invoked with '$*' (client: ${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT}@${SUNSHINE_CLIENT_FPS}) on $(uname -m)" >>"$HOME/.config/sunshine/sunshine_script.log"

  if [ -n "$1" ]; then
    RES="$1"
    REFRESH="${2:-60}"
  elif [ -n "$SUNSHINE_CLIENT_WIDTH" ] && [ -n "$SUNSHINE_CLIENT_HEIGHT" ]; then
    RES="${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT}"
    REFRESH="${SUNSHINE_CLIENT_FPS:-60}"
  else
    RES="2560x1440"
    REFRESH="60"
  fi

  # 1. If BetterDisplay virtual screen is active, set resolution dynamically on it
  if command -v betterdisplaycli >/dev/null 2>&1; then
    if betterdisplaycli get -identifiers 2>/dev/null | grep -qE "(Remote Screen|Galaxy Tab)"; then
      echo "monctl: setting BetterDisplay Remote Screen resolution to $RES" >>"$HOME/.config/sunshine/sunshine_script.log"
      betterdisplaycli set -nameLike="DELL" -mirror=off 2>/dev/null || true
      betterdisplaycli set -nameLike="Remote Screen" -resolution="$RES" 2>/dev/null || true
      betterdisplaycli set -nameLike="Remote Screen" -main=on 2>/dev/null || true
      exit 0
    fi
  fi

  # 2. Fallback to displayplacer on physical display
  if ! command -v displayplacer >/dev/null 2>&1; then
    echo "monctl: displayplacer not found in PATH ($PATH). Install with: brew install displayplacer" >>"$HOME/.config/sunshine/sunshine_script.log"
    exit 0
  fi

  CMD=$(python3 -c '
import subprocess, re, sys

target_res = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else "2560x1440"
try:
    target_hz = float(sys.argv[2])
except (IndexError, ValueError):
    target_hz = 60.0

try:
    out = subprocess.check_output(["displayplacer", "list"], text=True)
    screens = out.split("Persistent screen id: ")
    for screen in screens[1:]:
        lines = screen.splitlines()
        screen_id = lines[0].strip()
        is_main = any("main display" in l for l in lines)
        if is_main:
            modes = []
            tw, th = map(int, target_res.split("x"))
            for line in lines:
                m = re.search(r"mode (\d+):\s+res:(\d+)x(\d+)\s+hz:(\d+)", line)
                if m:
                    modes.append((m.group(1), int(m.group(2)), int(m.group(3)), float(m.group(4))))

            # 1. Exact resolution match
            exact = [m for m in modes if m[1] == tw and m[2] == th]
            if exact:
                exact.sort(key=lambda x: abs(x[3] - target_hz))
                print(f"displayplacer \"id:{screen_id} mode:{exact[0][0]}\"")
                sys.exit(0)

            # 2. Closest resolution match (rank by width & height closeness, then refresh rate)
            def score(m):
                w_diff = abs(m[1] - tw)
                h_diff = abs(m[2] - th)
                hz_diff = abs(m[3] - target_hz)
                return (w_diff * 2 + h_diff, hz_diff)

            modes_sorted = sorted(modes, key=score)
            if modes_sorted:
                print(f"displayplacer \"id:{screen_id} mode:{modes_sorted[0][0]}\"")
                sys.exit(0)
except Exception as e:
    pass
' "$RES" "$REFRESH" 2>/dev/null)

  if [ -n "$CMD" ]; then
    echo "monctl: executing $CMD" >>"$HOME/.config/sunshine/sunshine_script.log"
    eval "$CMD"
  else
    echo "monctl: fallback to displayplacer res:$RES" >>"$HOME/.config/sunshine/sunshine_script.log"
    displayplacer "res:$RES" 2>/dev/null || true
  fi
  exit 0
fi

MAIN="HDMI-1"
DUMMY="DP-6"

# Dynamically detect Flatpak or Toolbx/Distrobox containers
RUN=()
if [ -f /.flatpak-info ] || [ -f /run/.containerenv ]; then
  RUN=(flatpak-spawn --host --env=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" --env=XAUTHORITY="$XAUTHORITY")
fi

echo "Running as $XDG_CURRENT_DESKTOP on $WAYLAND_DISPLAY" >>"$HOME/.config/sunshine/sunshine_script.log"

if [ -n "$1" ]; then
  RES="$1"
  REFRESH="${2:-60}"
elif [ -n "$SUNSHINE_CLIENT_WIDTH" ] && [ -n "$SUNSHINE_CLIENT_HEIGHT" ]; then
  RES="${SUNSHINE_CLIENT_WIDTH}x${SUNSHINE_CLIENT_HEIGHT}"
  REFRESH="${SUNSHINE_CLIENT_FPS:-60}"
else
  RES="2560x1440"
  REFRESH="120"
fi
SCALE=${3:-1}

case "$XDG_CURRENT_DESKTOP" in
"KDE")
  "${RUN[@]}" kscreen-doctor output."$DUMMY".mode."$RES"@"${REFRESH}" output."$DUMMY".scale."$SCALE"
  ;;
"COSMIC")
  WIDTH=$(echo "$RES" | cut -d'x' -f1)
  HEIGHT=$(echo "$RES" | cut -d'x' -f2)

  "${RUN[@]}" cosmic-randr mode --refresh "$REFRESH" "$DUMMY" "$WIDTH" "$HEIGHT"
  "${RUN[@]}" cosmic-randr mode --scale "$SCALE" "$DUMMY" "$WIDTH" "$HEIGHT"
  ;;
"GNOME" | *"GNOME"*)
  GNOME_DUMMY=$(echo "$DUMMY" | sed 's/-A-/-/g')

  # Force the script to talk to the active user's GNOME session
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

  # Resolve closest supported refresh rate for requested resolution
  MODE=$(python3 -c '
import subprocess, re, sys
connector = sys.argv[1]
target_res = sys.argv[2]
try:
    target_ref = float(sys.argv[3])
except (ValueError, IndexError):
    target_ref = 60.0

try:
    out = subprocess.check_output(["gdctl", "show", "-m"], text=True)
    lines = out.splitlines()
    in_mon = False
    modes = []
    for line in lines:
        if f"Monitor {connector}" in line:
            in_mon = True
        elif in_mon and "Monitor " in line:
            break
        elif in_mon:
            m = re.search(r"(\d+x\d+)@([\d.]+)", line)
            if m and m.group(1) == target_res:
                modes.append((float(m.group(2)), f"{m.group(1)}@{m.group(2)}"))
    if modes:
        modes.sort(key=lambda x: abs(x[0] - target_ref))
        print(modes[0][1])
except Exception:
    pass
' "$GNOME_DUMMY" "$RES" "$REFRESH" 2>/dev/null)

  TARGET_MODE="${MODE:-${RES}@${REFRESH}}"
  "${RUN[@]}" gdctl set -L -p -M "$GNOME_DUMMY" -m "$TARGET_MODE" -s "$SCALE"
  ;;
esac
