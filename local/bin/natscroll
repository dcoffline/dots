#!/bin/bash

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

# macOS support
if [[ "$OSTYPE" == darwin* ]]; then
  if [ "$1" = "disable" ] || [ "$1" = "off" ]; then
    defaults write -g com.apple.swipescrolldirection -bool false
  else
    defaults write -g com.apple.swipescrolldirection -bool true
  fi
  exit 0
fi

DESKTOP="${XDG_CURRENT_DESKTOP:-GNOME}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
RUN=()
if [ -f /.flatpak-info ] || [ -f /run/.containerenv ]; then
  RUN=(flatpak-spawn --host --env=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" --env=XAUTHORITY="$XAUTHORITY")
fi

case "$DESKTOP" in
*"KDE"*|plasma)
  # Plasma 6: per-device NaturalScroll lives in ~/.config/kcminputrc.
  # Target the virtual HID mouse specifically (USB mice keep their own setting).
  # Edited directly (kwriteconfig6 host binary can't run inside a distrobox).
  CONF="$HOME/.config/kcminputrc"
  if [ "$1" = "disable" ] || [ "$1" = "off" ]; then V=false; else V=true; fi
  if grep -q '\[Libinput\]\[4617\]\[3\]\[libvirtualhid Mouse\]' "$CONF" 2>/dev/null; then
    sed -i "/\[Libinput\]\[4617\]\[3\]\[libvirtualhid Mouse\]/,/^\[/ s/^NaturalScroll=.*/NaturalScroll=$V/" "$CONF"
  else
    printf '\n[Libinput][4617][3][libvirtualhid Mouse]\nNaturalScroll=%s\n' "$V" >> "$CONF"
  fi
  # Tell running Plasma to reload input settings
  timeout 2 dbus-send --session --type=method_call --dest=org.kde.KWin     /KWin org.kde.KWin.reconfigure 2>/dev/null || true
  ;;
*)
  # GNOME: toggle gsettings
  if [ "$1" = "disable" ] || [ "$1" = "off" ]; then
    # Disable natural-scroll
    timeout 2 "${RUN[@]}" env -u GSETTINGS_BACKEND /usr/bin/gsettings set org.gnome.desktop.peripherals.mouse natural-scroll false
  else
    # Enable natural-scroll
    timeout 2 "${RUN[@]}" env -u GSETTINGS_BACKEND /usr/bin/gsettings set org.gnome.desktop.peripherals.mouse natural-scroll true
  fi
  ;;
esac
