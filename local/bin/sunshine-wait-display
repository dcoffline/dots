#!/bin/bash
# macOS has no Mutter or DRM; display is managed by CoreGraphics
if [[ "$OSTYPE" == darwin* ]]; then
  exit 0
fi

DESKTOP="${XDG_CURRENT_DESKTOP:-GNOME}"
TIMEOUT=30
ELAPSED=0

export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

case "$DESKTOP" in
*"KDE"*|plasma)
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  # Ensure standby virtual monitor service is running so headless boots / TV-off states always have an output
  if command -v krfb-virtualmonitor >/dev/null 2>&1; then
    if ! kscreen-doctor --json 2>/dev/null | jq -e '.outputs[] | select(.name == "Virtual-sunshine-vmon")' >/dev/null 2>&1; then
      systemctl --user stop sunshine-vmon.service 2>/dev/null || true
      systemd-run --user --unit=sunshine-vmon --collect --property=TimeoutStopSec=1s \
        krfb-virtualmonitor --resolution 1920x1080 --name sunshine-vmon --password sunshinepass --port 5905 >/dev/null 2>&1 || true
    fi
  fi
  # Wait for kscreen-doctor to show at least one enabled output
  while [ $ELAPSED -lt $TIMEOUT ]; do
    if command -v kscreen-doctor >/dev/null 2>&1; then
      PHYS_OUTS=$(kscreen-doctor --json 2>/dev/null | jq -r '.outputs[] | select(.name != "Virtual-sunshine-vmon" and .connected == true) | .name')
      if [ -n "$PHYS_OUTS" ]; then
        echo "$PHYS_OUTS" | while read -r out; do
          [ -n "$out" ] && kscreen-doctor "output.${out}.enable" >/dev/null 2>&1 || true
        done
        kscreen-doctor "output.Virtual-sunshine-vmon.disable" >/dev/null 2>&1 || true
      elif kscreen-doctor --json 2>/dev/null | jq -e '.outputs[] | select(.name == "Virtual-sunshine-vmon")' >/dev/null 2>&1; then
        kscreen-doctor "output.Virtual-sunshine-vmon.enable" >/dev/null 2>&1 || true
      fi
      if kscreen-doctor -o 2>/dev/null | grep -q "enabled"; then
        sleep 1.5
        exit 0
      fi
    fi
    sleep 1
    ELAPSED=$((ELAPSED + 1))
  done
  ;;
*)
  # Wait for GNOME Wayland & Mutter to report a valid logical monitor
  # Ensure Mutter hasn't left headless displays in power save mode
  busctl --user set-property org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig PowerSaveMode i 0 2>/dev/null

  while [ $ELAPSED -lt $TIMEOUT ]; do
    # 1. Does gdctl report an active logical monitor?
    # 2. Is there at least one DRM connector reporting 'enabled'?
    if gdctl show 2>/dev/null | grep -q "Logical monitor" \
       && grep -qs "enabled" /sys/class/drm/card*-*/enabled; then
      sleep 1.5
      exit 0
    fi
    sleep 1
    ELAPSED=$((ELAPSED + 1))
  done
  ;;
esac

echo "sunshine-wait-display: Timed out waiting for display after ${TIMEOUT}s" >&2
exit 0
