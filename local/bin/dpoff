#!/bin/bash

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

# macOS support
if [[ "$OSTYPE" == darwin* ]]; then
  echo "Running as macOS on $(uname -m)" >>"$HOME/.config/sunshine/sunshine_script.log"

  # Save pre-stream display configuration to restore on disconnect (ignore mirrored configs)
  if command -v displayplacer >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/sunshine"
    if [ ! -f "$HOME/.config/sunshine/.prev_displayplacer" ]; then
      PREV=$(displayplacer list 2>/dev/null | grep '^displayplacer ')
      if [[ -n "$PREV" && "$PREV" != *"+"* ]]; then
        echo "$PREV" > "$HOME/.config/sunshine/.prev_displayplacer"
      fi
    fi
  fi

  # If BetterDisplay virtual screen exists, unmirror, connect it and designate it as Main
  if command -v betterdisplaycli >/dev/null 2>&1; then
    if betterdisplaycli get -identifiers 2>/dev/null | grep -qE "(Remote Screen|Galaxy Tab)"; then
      betterdisplaycli set -nameLike="DELL" -mirror=off 2>/dev/null || true
      betterdisplaycli set -nameLike="Remote Screen" -connected=on 2>/dev/null || true
      sleep 0.5
      betterdisplaycli set -nameLike="Remote Screen" -main=on 2>/dev/null || true
    fi
  fi

  dock off
  touchup off
  natscroll off

  if [ -n "$1" ]; then
    monctl "$@"
  else
    monctl
  fi
  exit 0
fi

MAIN="HDMI-1"
DUMMY="DP-6"

# Source functions from bash (dock, osk, tablet, natscroll)
[ -f {$HOME}/.config/bash/function.bash ] && source {$HOME}/.config/bash/function.bash

# Dynamically detect Flatpak or Toolbx/Distrobox containers
RUN=()
if [ -f /.flatpak-info ] || [ -f /run/.containerenv ]; then
  RUN=(flatpak-spawn --host --env=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" --env=XAUTHORITY="$XAUTHORITY")
fi

echo "Running as $XDG_CURRENT_DESKTOP on $WAYLAND_DISPLAY" >>"$HOME/.config/sunshine/sunshine_script.log"

case "$XDG_CURRENT_DESKTOP" in
"KDE")
  "${RUN[@]}" kscreen-doctor output."$DUMMY".enable
  sleep 1
  "${RUN[@]}" kscreen-doctor output."$MAIN".disable
  ;;
"COSMIC")
  "${RUN[@]}" cosmic-randr enable "$DUMMY"
  sleep 1
  "${RUN[@]}" cosmic-randr disable "$MAIN"
  ;;
"GNOME" | *"GNOME"*)
  GNOME_DUMMY=$(echo "$DUMMY" | sed 's/-A-/-/g')

  # 1. Force the script to talk to the active user's GNOME session
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

  # 2. Tell Mutter directly to change Display Power to ON (0)
  "${RUN[@]}" busctl --user set-property org.gnome.Mutter.DisplayConfig /org/gnome/Mutter/DisplayConfig org.gnome.Mutter.DisplayConfig PowerSaveMode i 0
  sleep 1
  # Retry fallbacks: an unsupported client resolution must never abort
  # the launch (Sunshine treats prep-cmd failure as fatal).
  "${RUN[@]}" gdctl set -L -p -M "$GNOME_DUMMY" \
    || "${RUN[@]}" gdctl set -L -p -M "$GNOME_DUMMY" -m 2560x1440@119.877 \
    || "${RUN[@]}" gdctl set -L -p -M "$GNOME_DUMMY" -m 1920x1080@119.877

  # 3. Turn off dock, natscroll, tablet
  dock off
  touchup off
  natscroll off
  ;;
esac
monctl
