#!/bin/bash

# Path to your local Logseq markdown directory
LOGSEQ_DIR="$HOME/src/logseq/Hemati"

cd "$LOGSEQ_DIR" || exit

echo "🔄 Pulling down latest mobile changes from GitHub..."
git pull origin main --ff-only

echo "🚀 Launching Logseq..."
# Launches the application and waits until you close it
# (Adjust this command if you run Logseq via Flatpak or AppImage)
/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=run.sh --file-forwarding com.logseq.Logseq

echo "📦 Logseq closed. Bundling and pushing changes to GitHub..."
git add .
git commit -m "Linux Sync: $(date '+%Y-%m-%d %H:%M:%S')"
git push origin main
   
echo "✅ Sync complete!"
