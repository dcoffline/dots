#!/bin/bash

# Source 'dock' and 'tablet' functions from bash
[ -f ${HOME}/.config/bash/function.bash ] && source ${HOME}/.config/bash/function.bash

if [ -z "$XDG_CURRENT_DESKTOP" ]; then
  if pgrep -x gnome-shell >/dev/null 2>&1; then
    XDG_CURRENT_DESKTOP="GNOME"
  elif pgrep -x kwin_wayland >/dev/null 2>&1; then
    XDG_CURRENT_DESKTOP="KDE"
  elif pgrep -x cosmic-session >/dev/null 2>&1; then
    XDG_CURRENT_DESKTOP="COSMIC"
  fi
fi

case "$XDG_CURRENT_DESKTOP" in
"GNOME" | *"GNOME"*)
  if [ "$1" = "undo" ] || [ "$1" = "off" ]; then
    dock off
  else
    dock
  fi
  ;;
esac
