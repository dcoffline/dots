#!/bin/bash

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

# macOS support
if [[ "$OSTYPE" == darwin* ]]; then
  echo "Running as macOS on $(uname -m)" >>"$HOME/.config/sunshine/sunshine_script.log"

  # 1. Restore Dell physical monitor as Main display at (0,0) and move Remote Screen to (2560,1440)
  python3 -c '
import subprocess, re

try:
    out = subprocess.check_output(["displayplacer", "list"], text=True)
    screens = out.split("Persistent screen id: ")
    v_id = None
    p_id = None
    v_res = "2560x1440"

    for s in screens[1:]:
        lines = s.splitlines()
        sid = lines[0].strip()
        if sid.startswith("0BDA5B94") or "s3546859106" in sid:
            v_id = sid
            for l in lines:
                m = re.match(r"^Resolution:\s+(\d+x\d+)", l)
                if m:
                    v_res = m.group(1)
        elif sid.startswith("8FF805E8") or "s1095512908" in sid:
            p_id = sid

    if p_id and v_id:
        cmd = ["displayplacer", f"id:{p_id} res:2560x1440 hz:75 color_depth:8 enabled:true scaling:off origin:(0,0) degree:0", f"id:{v_id} res:{v_res} origin:(2560,1440) degree:0"]
        subprocess.check_call(cmd)
    elif p_id:
        subprocess.check_call(["displayplacer", f"id:{p_id} res:2560x1440 hz:75 color_depth:8 enabled:true scaling:off origin:(0,0) degree:0"])

    # Warp cursor back to center of Dell physical screen
    try:
        import ctypes
        cg = ctypes.cdll.LoadLibrary("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
        class CGPoint(ctypes.Structure):
            _fields_ = [("x", ctypes.c_double), ("y", ctypes.c_double)]
        cg.CGWarpMouseCursorPosition.argtypes = [CGPoint]
        cg.CGWarpMouseCursorPosition(CGPoint(1280.0, 720.0))
    except Exception:
        pass
except Exception as e:
    pass
' 2>/dev/null || true

  # 2. Restore DELL brightness to 100% (keep Remote Screen connected so display ID never resets)
  if command -v betterdisplaycli >/dev/null 2>&1; then
    betterdisplaycli set -nameLike="DELL" -mirror=off 2>/dev/null || true
    betterdisplaycli set -nameLike="DELL" -brightness=1.0 2>/dev/null || true
    betterdisplaycli set -deviceType=Display -main=on 2>/dev/null || true
  fi

  rm -f "$HOME/.config/sunshine/.prev_displayplacer"
  exit 0
fi

MAIN="HDMI-1"
DUMMY="DP-6"
RES="1280x720"
REFRESH="60"
SCALE="1"

# Source functions from bash (dock, osk, tablet, natscroll)
[ -f {$HOME}/.config/bash/function.bash ] && source {$HOME}/.config/bash/function.bash

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -z "$XDG_CURRENT_DESKTOP" ]; then
  if pgrep -x kwin_wayland >/dev/null 2>&1; then
    export XDG_CURRENT_DESKTOP="KDE"
  elif pgrep -x gnome-shell >/dev/null 2>&1; then
    export XDG_CURRENT_DESKTOP="GNOME"
  elif pgrep -x cosmic-comp >/dev/null 2>&1; then
    export XDG_CURRENT_DESKTOP="COSMIC"
  fi
fi

if [ -z "$WAYLAND_DISPLAY" ] || [ ! -S "${XDG_RUNTIME_DIR}/$WAYLAND_DISPLAY" ]; then
  for s in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
    if [ -S "$s" ]; then
      export WAYLAND_DISPLAY="$(basename "$s")"
      break
    fi
  done
fi
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

# Dynamically detect Flatpak or Toolbx/Distrobox containers
RUN=()
if [ -f /.flatpak-info ] || [ -f /run/.containerenv ]; then
  RUN=(flatpak-spawn --host --env=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" --env=XAUTHORITY="$XAUTHORITY")
fi

echo "Running as $XDG_CURRENT_DESKTOP on $WAYLAND_DISPLAY" >>"$HOME/.config/sunshine/sunshine_script.log"

case "$XDG_CURRENT_DESKTOP" in
"KDE" | *"KDE"* | plasma)
  PHYS_OUTS=$("${RUN[@]}" kscreen-doctor --json 2>/dev/null |
    jq -r '.outputs[] | select(.name != "Virtual-sunshine-vmon" and .connected == true) | .name')

  if [ -n "$PHYS_OUTS" ]; then
    # Re-enable all connected physical monitors and close the virtual display
    echo "$PHYS_OUTS" | while read -r out; do
      [ -n "$out" ] && "${RUN[@]}" kscreen-doctor "output.${out}.enable"
    done
    "${RUN[@]}" systemctl --user stop sunshine-vmon.service 2>/dev/null || true
  else
    # Headless / TV off: ensure Virtual-sunshine-vmon is running so KWin and Sunshine always have an active wl_output
    if ! "${RUN[@]}" kscreen-doctor --json 2>/dev/null | jq -e '.outputs[] | select(.name == "Virtual-sunshine-vmon")' >/dev/null 2>&1; then
      "${RUN[@]}" systemctl --user stop sunshine-vmon.service 2>/dev/null || true
      "${RUN[@]}" systemd-run --user --unit=sunshine-vmon --collect --property=TimeoutStopSec=1s \
        --setenv=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
        krfb-virtualmonitor --resolution 1920x1080 --name sunshine-vmon --password sunshinepass --port 5905
      for _ in {1..25}; do
        if "${RUN[@]}" kscreen-doctor --json 2>/dev/null | jq -e '.outputs[] | select(.name == "Virtual-sunshine-vmon")' >/dev/null 2>&1; then
          break
        fi
        sleep 0.2
      done
    fi
  fi
  ;;
"COSMIC")
  WIDTH=$(echo "$RES" | cut -d'x' -f1)
  HEIGHT=$(echo "$RES" | cut -d'x' -f2)
  "${RUN[@]}" cosmic-randr enable "$MAIN"
  "${RUN[@]}" cosmic-randr mode --refresh "$REFRESH" "$MAIN" "$WIDTH" "$HEIGHT"
  "${RUN[@]}" cosmic-randr mode --scale "$SCALE" "$MAIN" "$WIDTH" "$HEIGHT"
  sleep 1
  "${RUN[@]}" cosmic-randr disable "$DUMMY"
  ;;
"GNOME" | *"GNOME"*)
  GNOME_DUMMY=$(echo "$DUMMY" | sed 's/-A-/-/g')
  GNOME_MAIN=$(echo "$MAIN" | sed 's/-A-/-/g')

  # Force the script to talk to the active user's GNOME session
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

  # Resolve closest supported refresh rate for requested resolution
  MODE=$(python3 -c '
import subprocess, re, sys
connector = sys.argv[1]
target_res = sys.argv[2]
try:
    target_ref = float(sys.argv[3])
except (ValueError, IndexError):
    target_ref = 60.0

try:
    out = subprocess.check_output(["gdctl", "show", "-m"], text=True)
    lines = out.splitlines()
    in_mon = False
    modes = []
    for line in lines:
        if f"Monitor {connector}" in line:
            in_mon = True
        elif in_mon and "Monitor " in line:
            break
        elif in_mon:
            m = re.search(r"(\d+x\d+)@([\d.]+)", line)
            if m and m.group(1) == target_res:
                modes.append((float(m.group(2)), f"{m.group(1)}@{m.group(2)}"))
    if modes:
        modes.sort(key=lambda x: abs(x[0] - target_ref))
        print(modes[0][1])
except Exception:
    pass
' "$GNOME_MAIN" "$RES" "$REFRESH" 2>/dev/null)

  # Fallback formatting if python lookup fails
  if [ -z "$MODE" ]; then
    GNOME_REFRESH="$REFRESH"
    if [[ "$GNOME_REFRESH" =~ ^[0-9]+$ ]]; then
      GNOME_REFRESH="${GNOME_REFRESH}.000"
    fi
    MODE="${RES}@${GNOME_REFRESH}"
  fi

  # Best-effort restore: if HDMI-A-1 is unplugged/headless, skip the mode
  # set instead of failing (a prep-cmd exit 1 blocks Sunshine launches).
  timeout 2 "${RUN[@]}" gdctl set -L -p -s "$SCALE" -M "$GNOME_MAIN" -m "$MODE" || true
  dock on
  ;;
esac
natscroll on
