#!/bin/bash

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

# macOS support
if [[ "$OSTYPE" == darwin* ]]; then
  if [ "$1" = "disable" ] || [ "$1" = "off" ]; then
    # No equivalent on macOS
    exit 0
  fi
fi

DESKTOP="${XDG_CURRENT_DESKTOP:-GNOME}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
RUN=()
if [ -f /.flatpak-info ] || [ -f /run/.containerenv ]; then
  RUN=(flatpak-spawn --host --env=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" --env=XAUTHORITY="$XAUTHORITY")
fi

case "$DESKTOP" in
*"KDE"*|plasma)
  if [ "$1" = "disable" ] || [ "$1" = "off" ]; then
    echo "touchup: KDE mode — setting VirtualKeyboard.mode=1 (touch-only)" >>"$HOME/.config/sunshine/sunshine_script.log" 2>/dev/null || true
    timeout 2 "${RUN[@]}" qdbus org.kde.KWin /VirtualKeyboard org.kde.kwin.VirtualKeyboard.mode 1 >/dev/null 2>&1 || true
  else
    echo "touchup: KDE mode — setting VirtualKeyboard.mode=2 (always)" >>"$HOME/.config/sunshine/sunshine_script.log" 2>/dev/null || true
    timeout 2 "${RUN[@]}" kwriteconfig6 --file kwinrc --group Wayland --key InputMethod /usr/share/applications/org.kde.plasma.keyboard.desktop 2>/dev/null || true
    timeout 2 "${RUN[@]}" qdbus org.kde.KWin /VirtualKeyboard org.kde.kwin.VirtualKeyboard.active true >/dev/null 2>&1 || true
    timeout 2 "${RUN[@]}" qdbus org.kde.KWin /VirtualKeyboard org.kde.kwin.VirtualKeyboard.mode 2 >/dev/null 2>&1 || true
  fi
  ;;
*)
  # GNOME: toggle accessibility and extension state
  if [ "$1" = "disable" ] || [ "$1" = "off" ]; then
    timeout 2 "${RUN[@]}" env -u GSETTINGS_BACKEND /usr/bin/gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled false
    timeout 2 "${RUN[@]}" gnome-extensions disable touchup@mityax
    timeout 2 "${RUN[@]}" gnome-extensions disable dash-to-dock@micxgx.gmail.com
    timeout 2 "${RUN[@]}" gnome-extensions enable hotedge@jonathan.jdoda.ca
  else
    timeout 2 "${RUN[@]}" env -u GSETTINGS_BACKEND /usr/bin/gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true
    timeout 2 "${RUN[@]}" gnome-extensions enable touchup@mityax
    timeout 2 "${RUN[@]}" gnome-extensions disable dash-to-dock@micxgx.gmail.com
    timeout 2 "${RUN[@]}" gnome-extensions disable hotedge@jonathan.jdoda.ca
  fi
  ;;
esac
