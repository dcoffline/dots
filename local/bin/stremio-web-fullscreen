#!/bin/bash
# Stremio Web Fullscreen Launcher for Steam / Moonlight
(
  for i in {1..12}; do
    WID=$(wmctrl -l | grep -i "Stremio" | awk '{print $1}')
    if [ -n "$WID" ]; then
      wmctrl -i -r "$WID" -b add,fullscreen
      break
    fi
    sleep 0.5
  done
) &

exec /usr/bin/flatpak run --command=/app/bin/chrome com.google.Chrome "--profile-directory=Profile 2" --app=https://web.stremio.com --start-fullscreen "$@"
