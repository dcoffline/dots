.DS_Store
.*hist*
*.db
*.sqlite
*._*
local/share/homepage/log/
dotfiles.key

# --- hardened secret hygiene (2026-09-06) ---
# --- hardened secret hygiene (2026-09-06) ---
# .secrets + rclone.conf are ALREADY git-crypt encrypted; these protect FUTURE accidents
# Generic secret-shaped files (gitignore-level): keep out of the tree entirely
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
*.jks
credentials
credentials.json
.env
.env.*
!.env.example
*.secret
secrets.*
*.sqlite
*.db
*_key.pem
git-crypt.key

# OAuth / service account blobs
*service-account*.json
*client_secret*.json
oauth*.token
*.token

# dotfiles that commonly hold creds (in addition to .secrets which is encrypted)
config/environment.d/envvars.conf.local
local/bin/uv
# secret-incident untracks (2026-10-13)
config/dconf-backups/stremio-addons-backup-2026-05-19.json
local/share/homepage/logs/homepage.log

# per-service env files ARE tracked (git-crypt) - negate the blanket .env rule
# (2026-10-15: .gitignore .env silently excluded every Phase-1 per-service env)
!local/share/**/*.env
__pycache__/
