[Unit]
Description=Ollama ROCm API Service
After=network-online.target

[Container]
Image=docker.io/ollama/ollama:rocm
ContainerName=ollama
AutoUpdate=registry
Network=homelab.network

# Expose the API to your local network / host loopback
PublishPort=127.0.0.1:11434:11434

# Persistent storage for downloaded models
Volume=%h/.local/share/ollama:/root/.ollama:Z

# Pass the AMD GPU kernel devices into the container
AddDevice=/dev/kfd
AddDevice=/dev/dri

# Allow the container to use the host's video/render groups
GroupAdd=keep-groups
SecurityLabelDisable=true

# Radeon 780M iGPU is gfx1103, which the bundled ROCm rocblas lacks; map it to the
# RDNA3 gfx1100 target so ollama uses the GPU instead of silently falling back to CPU.
# Rollback: delete these two HSA/IGPU lines and restart ollama.service.
Environment=HSA_OVERRIDE_GFX_VERSION=11.0.0
# Ollama drops integrated GPUs unless explicitly enabled.
Environment=OLLAMA_IGPU_ENABLE=1
Environment=OLLAMA_NUM_CTX=4096
Environment=OLLAMA_ORIGINS=*

#Label=homepage.name=Ollama
#Label=homepage.group=AI
#Label=homepage.icon=ollama
#Label=homepage.href=https://ollama.hemati.com
#Label="homepage.description=LLM Inference"

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
