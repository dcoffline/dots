[Unit]
Description=Open WebUI Frontend
After=network-online.target ollama.service searxng.service

[Container]
Image=ghcr.io/open-webui/open-webui:main
ContainerName=open-webui
AutoUpdate=registry
Network=homelab.network
# Exposes the web interface on port 3000
#PublishPort=3000:8080

# Persistent storage for your chat history and uploaded docs
Volume=%h/.local/share/open-webui:/app/backend/data:Z
# Mount the curated Open WebUI knowledge pack into the container
Volume=%h/Documents/Notes/Hemati/openwebui:/app/backend/data/openwebui:Z

# Points the frontend at the colibri OpenAI-compatible API (DS4 Flash).
# host.containers.internal is Podman's way of reaching the host machine.
Environment=OPENAI_API_BASE_URL=http://host.containers.internal:8001/v1
Environment=OPENAI_API_KEY=06e47feaef41b7d8ce27b194194e3ee44c954d384d89110a
Environment=OLLAMA_BASE_URL=http://ollama:11434

# SearXNG Web Search integration
Environment=ENABLE_WEB_SEARCH=True
Environment=WEB_SEARCH_ENGINE=searxng
Environment=ENABLE_RAG_WEB_SEARCH=True
Environment=RAG_WEB_SEARCH_ENGINE=searxng
Environment=SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>&format=json

Label=homepage.name=Open-WebUI
Label=homepage.group=AI
Label=homepage.icon=https://cdn.jsdelivr.net/gh/selfhst/icons/svg/open-webui.svg
Label=homepage.href=https://chat.hemati.com
Label="homepage.description=Local AI Chat"

[Service]
Restart=always

[Install]
WantedBy=default.target
