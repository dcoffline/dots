[Unit]
Description=Scrob - self-hosted media tracker

[Container]
ContainerName=scrob
Image=docker.io/bellamy/scrob:latest
AutoUpdate=registry
Network=homelab.network
PublishPort=127.0.0.1:7330:7330
EnvironmentFile=%h/.local/share/scrob/.env
Volume=scrob_data:/app/backend/data:Z
HealthCmd=python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7330/', timeout=5).status==200 else 1)"
HealthInterval=60s
HealthRetries=3
HealthStartPeriod=30s
Volume=/var/home/eric/.mnt/2T/local/hermes/scrob-entrypoint.sh:/entrypoint.sh:ro,Z

Label=homepage.name=Scrob
Label=homepage.href=https://scrob.hemati.com
Label=homepage.group=Content
Label=homepage.icon=scrob
Label=homepage.href=https://scrob.hemati.com
Label="homepage.description=Media and List Tracker"

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
