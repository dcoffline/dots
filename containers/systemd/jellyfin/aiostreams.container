[Unit]
Description=AIOStreams Aggregator Service
After=network-online.target

[Container]
ContainerName=aiostreams

# Healthcheck so podman/boot-health detects Up-but-hung
HealthCmd=/nodejs/bin/node -e "fetch('http://localhost:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
Image=ghcr.io/viren070/aiostreams:v2.36.0
Network=homelab.network
EnvironmentFile=%h/.local/share/aiostreams/.env
Environment=BASE_URL=https://aiostreams.hemati.com
Environment=JELLYFIN_PIN_SIGN_IN=true
# NOTE: NODE_OPTIONS (incl. --max-http-header-size=65536 for Gelato 431 fix) lives in ~/.local/share/aiostreams/.env — quadlet cannot quote spaced envs.

# Persistent storage for local instance databases/sessions
Volume=%h/.local/share/aiostreams:/app/data:Z

Label=homepage.name=AIOStreams
Label=homepage.group=Content
Label=homepage.icon=https://cdn.jsdelivr.net/gh/selfhst/icons/png/aiostreams-light.png
Label=homepage.href=https://aiostreams.hemati.com/jellyfin
Label="homepage.description=Stream Aggregator"

[Service]
Restart=always

[Install]
WantedBy=default.target
