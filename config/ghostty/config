#theme = Nord
#window-theme = ghostty
window-height = 33
window-width = 100
window-padding-x = 5
window-padding-y = 5

#font-family = Hack Nerd Font
#font-family-bold = Hack Nerd Font
#font-family-italic = Hack Nerd Font
#font-family-bold-italic = Hack Nerd Font
#font-size = 16

cursor-style = block
cursor-style-blink = true

#keybind = ctrl+up=scroll_page_lines:5
#keybind = ctrl+down=scroll_page_lines:-5 
keybind = ctrl+up=scroll_page_up
keybind = ctrl+down=scroll_page_down

background-opacity = 0.85
#gtk-titlebar = false
confirm-close-surface = false
shell-integration-features = no-cursor
