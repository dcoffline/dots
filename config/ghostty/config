#theme = Nord
#window-theme = ghostty
window-height = 33
window-width = 100
window-padding-x = 5
window-padding-y = 5

# You can generate the list of valid values using the CLI:
# ghostty +list-fonts

#font-family = CaskaydiaMono Nerd Font Mono
#font-family-bold = CaskaydiaMono NFM Bold
#font-family-italic = CaskaydiaMono NFM Italic
#font-family-bold-italic = CaskaydiaMono NFM Bold Italic

font-family = Hack Nerd Font Mono
font-family-bold = Hack Nerd Font Mono Bold
font-family-italic = Hack Nerd Font Mono Italic
font-family-bold-italic = Hack Nerd Font Bold Italic

font-size = 11

cursor-style = block
cursor-style-blink = true

#keybind = ctrl+up=scroll_page_lines:5
#keybind = ctrl+down=scroll_page_lines:-5 
keybind = ctrl+up=scroll_page_up
keybind = ctrl+down=scroll_page_down

background-opacity = 0.85
#gtk-titlebar = false
confirm-close-surface = false
shell-integration-features = no-cursor
