# Theme (Kitty default palette, pure #000000 background)
theme = Kitty Default
#window-theme = ghostty
# Default: KDE (server-side decorations, no row loss)
window-height = 27
window-width = 90

#window-padding-x = 5
#window-padding-y = 5
window-padding-balance = true

# Ghostty Drop-Down
#initial-window = false
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15
#gtk-tabs-location = hidden

# Typography / Fonts
# You can generate the list of valid values using the CLI: ghostty +list-fonts
font-family = CaskaydiaMono Nerd Font
#font-family = Hack Nerd Font
font-size = 11

# Replicate Kitty's stem darkening (macOS-only; ignored on Linux)
font-thicken = true

# Linux FreeType rendering tweaks for fuller strokes
freetype-load-flags = no-light,no-autohint
#font-style = SemiBold
alpha-blending = linear

# Replicate Kitty's vertical rhythm & line spacing
adjust-cell-height = -8%

cursor-style = block
cursor-style-blink = true

#keybind = ctrl+up=scroll_page_lines:5
#keybind = ctrl+down=scroll_page_lines:-5 
keybind = ctrl+up=scroll_page_up
keybind = ctrl+down=scroll_page_down

background-opacity = 0.8
#gtk-titlebar = false
confirm-close-surface = false
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
mouse-hide-while-typing = false

# GNOME CSD bug: header bar eats ~3 rows, so override via optional include
config-file = ?config-gnome

# MacOS: font size upscaled
config-file = ?config-macos
