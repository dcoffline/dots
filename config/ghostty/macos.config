# ==============================================================================
# macOS-Specific Ghostty Configuration Overrides
# ==============================================================================

# Larger font size for Retina displays (matching macOS Kitty setup)
font-size = 14

# Ensure regular terminal window opens on launch (overrides Linux drop-down mode)
initial-window = true

# Seamless titlebar blending into background (matching Kitty's macOS titlebar)
macos-titlebar-style = transparent
