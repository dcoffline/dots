[Desktop Entry]
Type=Application
Name=Orca Screen Reader
Exec=orca --replace
NoDisplay=true
X-GNOME-AutoRestart=true
AutostartCondition=GSettings org.gnome.desktop.a11y.applications screen-reader-enabled;GNOMESessionManagerHasModule orca
X-systemd-skip=true
Hidden=true
Comment=No comment set.
Terminal=false
