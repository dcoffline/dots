[Unit]
Description=MediaFusion PostgreSQL Database
After=network-online.target

[Container]
Image=docker.io/library/postgres:17-alpine
ContainerName=mediafusion-db
Network=homelab.network
Volume=mediafusion-db.volume:/var/lib/postgresql/data:Z
Environment=POSTGRES_USER=mediafusion
Environment=POSTGRES_PASSWORD=mediafusion
Environment=POSTGRES_DB=mediafusion

[Install]
WantedBy=default.target
