[Unit]
Description=Zurg WebDAV Server
After=network-online.target

[Container]
Image=ghcr.io/debridmediamanager/zurg-testing:latest
AutoUpdate=registry
ContainerName=zurg
Environment=TZ=America/Chicago
EnvironmentFile=%h/.secrets
Network=homelab.network
PublishPort=9999:9999

# The :Z tells SELinux to privately label this directory for this specific container
Volume=%h/.local/share/zurg/config.yml:/app/config.yml:Z
Volume=%h/.local/share/zurg/data:/app/data:Z

Label=homepage.name=Zurg
Label=homepage.group=Servers
Label=homepage.icon=real-debrid
Label=homepage.href=https://zurg.hemati.com
Label="homepage.description=Organize Media"
[Service]
Restart=always
# Gives Zurg enough time to cleanly shut down its internal database
TimeoutStopSec=30

[Install]
WantedBy=default.target
