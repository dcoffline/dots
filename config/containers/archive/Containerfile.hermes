FROM docker.io/nousresearch/hermes-agent:latest

# Install Chromium and dependencies
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-sandbox \
    fonts-liberation \
    libasound2t64 \
    libnspr4 \
    libnss3 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright into hermes virtualenv
RUN /usr/local/bin/uv pip install --python /opt/hermes/.venv/bin/python playwright || true

# Patch discord adapter to resolve forum threads defensively if channel is a forum parent
COPY patch_adapter.py /tmp/patch_adapter.py
RUN python3 /tmp/patch_adapter.py && rm /tmp/patch_adapter.py
