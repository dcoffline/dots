[Unit]
Description=MediaFlow Proxy Light (Rust Engine)
# Force systemd to wait until the Quadlet network unit is actually active
After=homelab-network.service
Requires=homelab-network.service

[Container]
Image=ghcr.io/mhdzumair/mediaflow-proxy-light:latest
ContainerName=mediaflow
AutoUpdate=registry
EnvironmentFile=%h/.secrets
Network=homelab.network

# Gives the container a tiny grace period to initialize network sockets
Label=homepage.name=MediaFlow
Label=homepage.group=Media
Label=homepage.icon=https://mediaflowtools.com/mediaflow-logo.svg
Label=homepage.href=https://mediaflow.hemati.com
Label="homepage.description=Debrid Cache Proxy"
[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
