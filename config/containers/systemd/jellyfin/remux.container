[Unit]
Description=Remux Media Server (Jellyfin-compatible, Stremio/AIOStreams)
After=network-online.target homelab-network.service
Requires=homelab-network.service

[Container]
ContainerName=remux
# Remux: Jellyfin-compatible media server replacing Gelato search/streaming.
# Speaks the Jellyfin API, bridges Stremio add-ons + local files + IPTV to Jellyfin clients.
Image=ghcr.io/lostb1t/remux:latest
Network=homelab.network
SecurityLabelDisable=true

# Publish port 8097 for local LAN / Tailscale (avoids collision with 8096 Jellyfin and 3001 FreeLLMAPI)
PublishPort=8097:3000

# Persistent Data (SQLite DB, torrents, caches, user profiles)
Volume=%h/.local/share/remux:/data:Z

# Bulk Media (Same local media pool as Jellyfin)
Volume=%h/.mnt/10T:/media:ro

# AMD Hardware Acceleration (Radeon 780M / VA-API)
AddDevice=/dev/dri
GroupAdd=keep-groups

Environment=TZ=America/Chicago
Environment=PORT=3000
Environment=DATA_DIR=/data
Environment=DATABASE_URL=sqlite:///data/db.sqlite?mode=rwc
Environment=LOG_FILE=/data/logs/remux.jsonl
Environment=TORRENT_DATA_DIR=/data/torrents

Label=homepage.name=Remux
Label=homepage.icon=jellyfin
Label=homepage.group=Media
Label=homepage.href=http://192.168.1.18:8097
Label="homepage.description=Stremio-Jellyfin Hybrid Server"

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
