[Unit]
Description=Jellyfin Media Server
After=network-online.target

[Container]
ContainerName=jellyfin
# DB was migrated to 12.0 schema (ExtraIds/Permission columns dropped).
# 10.11.11 binary + 12.0 DB = broken auth + Gelato SQLite errors.
# Back on latest (12.x) so the server matches the DB. Gelato is 10.11-only;
# Remux (ghcr.io/lostb1t/remux) is the replacement for Gelato search/streaming.
Image=docker.io/jellyfin/jellyfin:latest
Network=homelab.network
SecurityLabelDisable=true

# Publish port 8096 for local LAN and Tailscale access
PublishPort=8096:8096

# AMD Hardware Acceleration (Radeon 780M / VA-API)
AddDevice=/dev/dri
GroupAdd=keep-groups

# Config and Cache go on the fast SSD
Volume=%h/.local/share/jellyfin/config:/config
Volume=%h/.local/share/jellyfin/cache:/cache

# Bulk Media Storage on the HDD (Mounted read-only to prevent writing .nfo/thumbnails in media folders)
Volume=%h/.mnt/10T:/media:ro

Environment=TZ=America/Chicago

Label=homepage.name=Jellyfin
Label=homepage.icon=jellyfin
Label=homepage.group=Content
Label=homepage.href=https://media.hemati.com
Label="homepage.description=Home Media Server"

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
