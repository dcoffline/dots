[Unit]
Description=Zurg WebDAV Server
After=network-online.target

[Container]
Image=ghcr.io/debridmediamanager/zurg-testing:latest
AutoUpdate=registry
ContainerName=zurg
Environment=TZ=America/Chicago
EnvironmentFile=%h/.secrets
Network=homelab.network
PublishPort=9999:9999

# The :Z tells SELinux to privately label this directory for this specific container
Volume=%h/.local/share/zurg/config.yml:/app/config.yml:Z
Volume=%h/.local/share/zurg/data:/app/data:Z

Label=homepage.name=Zurg
Label=homepage.group=Containers
Label=homepage.icon=https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/d3421b05-2407-48f6-86e9-c2a49dcb115c/dhj5e62-a35c9d06-a959-4d4d-a5de-cab399d644d4.png?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..xNvX8cKGgIh2rQCJAkV5nFdXWSSIRMw3_HSkj-rOD7I
Label=homepage.href=https://zurg.hemati.com
Label="homepage.description=Organize Media"
[Service]
Restart=always
TimeoutStartSec=300
# Gives Zurg enough time to cleanly shut down its internal database
TimeoutStopSec=30

[Install]
WantedBy=default.target
