[Unit]
Description=AIOStreams Aggregator Service
After=network-online.target

[Container]
ContainerName=aiostreams
Image=ghcr.io/viren070/aiostreams:latest
AutoUpdate=registry
Network=homelab.network
EnvironmentFile=%h/.secrets
Environment=BASE_URL=https://aiostreams.hemati.com

# Persistent storage for local instance databases/sessions
Volume=%h/.local/share/aiostreams:/app/data:Z

Label=homepage.name=AIOStreams
Label=homepage.group=Servers
Label=homepage.icon=https://cdn.jsdelivr.net/gh/selfhst/icons/png/aiostreams-light.png
Label=homepage.href=https://aiostreams.hemati.com
Label="homepage.description=Stream Aggregator"
[Service]
Restart=always

[Install]
WantedBy=default.target
