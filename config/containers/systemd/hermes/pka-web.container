[Unit]
Description=PKA Knowledge Base Web Server
After=network-online.target

[Container]
ContainerName=pka-web
Image=localhost/pka-web:latest
AutoUpdate=local
Network=homelab.network
PublishPort=8888:8888
EnvironmentFile=%h/.secrets
Environment=PYTHONPATH=/app
Volume=%h/src/projects/pka-web:/app
Volume=%h/Documents/Notes/Hemati:/vault:ro
Volume=%h/.local/share/hermes/.env:/opt/data/.env:ro
WorkingDir=/app
Exec=python3 /app/server.py
SecurityLabelDisable=true

Label="homepage.name=PKA Vault"
Label=homepage.group=Servers
Label=homepage.icon=https://hemati.com/wp-content/uploads/2026/08/Hemati_favicon-removebg-preview-Edited.png
Label=homepage.href=https://pka.hemati.com
Label="homepage.description=Personal Knowledgebase"
[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
