[Unit]
Description=Ollama ROCm API Service
After=network-online.target

[Container]
Image=docker.io/ollama/ollama:rocm
ContainerName=ollama
AutoUpdate=registry
Network=homelab.network

# Expose the API to your local network
#PublishPort=11434:11434

# Persistent storage for downloaded models
Volume=%h/.local/share/ollama:/root/.ollama:Z

# Pass the AMD GPU kernel devices into the container
AddDevice=/dev/kfd
AddDevice=/dev/dri

# Allow the container to use the host's video/render groups
GroupAdd=keep-groups
SecurityLabelDisable=true

# High-performance Zen 4 AVX-512 inference (rock-solid, no GPU hangs)
Environment=OLLAMA_NUM_CTX=4096

Label=homepage.name=Ollama
Label=homepage.group=Servers
Label=homepage.icon=ollama
Label=homepage.href=http://10.89.0.100:11434
Label="homepage.description=Local LLM Inference Engine"
[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
