[Unit]
Description=Honcho PostgreSQL Vector Database
After=network-online.target

[Container]
ContainerName=honcho-db
Image=docker.io/pgvector/pgvector:pg16
AutoUpdate=registry
Network=homelab.network

Volume=%h/.local/share/honcho/db:/var/lib/postgresql/data:Z

Environment=POSTGRES_USER=postgres
Environment=POSTGRES_PASSWORD=postgres
Environment=POSTGRES_DB=honcho

# Healthcheck to ensure Postgres is ready before dependent services start
HealthCmd=pg_isready -U postgres -d honcho
HealthInterval=2s
HealthRetries=15
HealthTimeout=3s
HealthStartPeriod=2s
Notify=healthy

[Service]
Restart=always

[Install]
WantedBy=default.target
