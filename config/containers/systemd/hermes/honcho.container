[Unit]
Description=Plastic Labs Honcho AI Memory Server
Requires=honcho-db.service honcho-redis.service
After=network-online.target honcho-db.service honcho-redis.service

[Container]
ContainerName=honcho
Image=ghcr.io/plastic-labs/honcho:latest
AutoUpdate=registry
Network=homelab.network
PublishPort=127.0.0.1:8000:8000
Exec=sh docker/entrypoint.sh

Volume=%h/.local/share/honcho/data:/app/data:Z

# Database & Cache
Environment=DB_CONNECTION_URI=postgresql+psycopg://postgres:postgres@honcho-db:5432/honcho
Environment=CACHE_URL=redis://honcho-redis:6379/0?suppress=true
Environment=CACHE_ENABLED=true
Environment=AUTH_USE_AUTH=false

# LLM Deriver via OpenRouter (Gemini 2.5 Flash -> DeepSeek V3 fallback)
# LLM deriver/dialectic/summary/dream all route through freellmapi (model
# 'auto' = the gateway's own rotation). Key via dedicated env file - quadlet
# Environment= does NOT interpolate ${VAR} against EnvironmentFile.
EnvironmentFile=%h/.local/share/honcho/honcho-llm.env
Environment=DERIVER_MODEL_CONFIG__TRANSPORT=openai
Environment=DERIVER_MODEL_CONFIG__MODEL=auto
Environment=DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1
# Insurance: if the 'auto' rotation hands the deriver a model that botches
# tool-calling, fall back to a proven cheap tool-user.
Environment=DERIVER_MODEL_CONFIG__FALLBACK__TRANSPORT=openai
Environment=DERIVER_MODEL_CONFIG__FALLBACK__MODEL=gemini-2.5-flash
Environment=DERIVER_MODEL_CONFIG__FALLBACK__OVERRIDES__BASE_URL=http://freellmapi:3001/v1

# Vector Embedding via Local Ollama (Instant & 100% Private)
Environment=EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
Environment=EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text
Environment=EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://ollama:11434/v1
Environment=EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=ollama
Environment=EMBEDDING_VECTOR_DIMENSIONS=768

# All LLM features route through freellmapi; 'auto' = gateway rotation
# (Eric 2026-10-13: no pinned model, premium-agnostic, tool-calling
# variance handled by the gateway's own fallback/retry).
Environment=SUMMARY_MODEL_CONFIG__TRANSPORT=openai
Environment=SUMMARY_MODEL_CONFIG__MODEL=auto
Environment=SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1
Environment=DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
Environment=DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=auto
Environment=DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1
Environment=DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
Environment=DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=auto
Environment=DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1
Environment=DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
Environment=DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=auto
Environment=DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1
Environment=DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
Environment=DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=auto
Environment=DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1
Environment=DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
Environment=DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=auto
Environment=DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1
Environment=DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
Environment=DREAM_INDUCTION_MODEL_CONFIG__MODEL=auto
Environment=DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1
Environment=DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
Environment=DREAM_DEDUCTION_MODEL_CONFIG__MODEL=auto
Environment=DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://freellmapi:3001/v1

#Label=homepage.name=Honcho
#Label=homepage.group=AI
#Label=homepage.icon=https://hemati.com/wp-content/uploads/2026/08/Honcho-removebg-preview.png
#Label=homepage.href=https://honcho.hemati.com/docs
#Label="homepage.description=AI Memory"

[Service]
TimeoutStartSec=300
Restart=always

[Install]
WantedBy=default.target
