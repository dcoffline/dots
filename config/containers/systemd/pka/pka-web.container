[Unit]
Description=PKA Knowledge Base Web Server
After=network-online.target

[Container]
ContainerName=pka-web
Image=pka-web:latest
Network=homelab.network
PublishPort=8888:8888
Volume=/var/home/athena/projects/PKA_Hemati:/app:Z
WorkingDir=/app
Exec=python3 /app/server.py
SecurityLabelDisable=true

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
