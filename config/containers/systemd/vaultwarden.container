[Unit]
Description=Vaultwarden Server
After=network-online.target

[Container]
Image=docker.io/vaultwarden/server:latest
ContainerName=vaultwarden
AutoUpdate=registry
Environment=DOMAIN=https://vault.hemati.com
Environment=SIGNUPS_ALLOWED=false
Environment=DATABASE_URL=/data/db.sqlite3
Volume=%h/.local/share/vaultwarden:/data:Z
Network=homelab.network
EnvironmentFile=%h/.secrets

Label=homepage.name=Vaultwarden
Label=homepage.group=Utilities
Label=homepage.icon=bitwarden
Label=homepage.href=https://vault.hemati.com
Label="homepage.description=Password Manager"
[Service]
Restart=always

[Install]
WantedBy=default.target
