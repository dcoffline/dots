[Unit]
Description=Immich Photo Engine
# Tell it to wait for the other three containers to boot first
Requires=immich-db.service immich-redis.service immich-ml.service
After=network-online.target immich-db.service immich-redis.service immich-ml.service
StartLimitIntervalSec=0

[Container]
# Add the name for Cloudflare
ContainerName=immich-server
Network=homelab.network
Image=ghcr.io/immich-app/immich-server:release
AutoUpdate=registry
PublishPort=2283:2283
SecurityLabelDisable=true

# Thumbs/profile/upload stay on 2T SSD; bulk media/backups go to 10T HDD
Volume=%h/.mnt/2T/immich:/usr/src/app/upload
Volume=%h/.mnt/10T/immich/encoded-video:/usr/src/app/upload/encoded-video
Volume=%h/.mnt/10T/immich/library:/usr/src/app/upload/library
Volume=%h/.mnt/10T/immich/backups:/usr/src/app/upload/backups
Volume=%h/.mnt/10T/Pictures/Camera:/mnt/external

# Give it the "keys" to the database
EnvironmentFile=%h/.local/share/immich/.env
Environment=DB_HOSTNAME=immich-db
Environment=DB_DATABASE_NAME=immich

Environment=REDIS_HOSTNAME=immich-redis
Environment=IMMICH_MACHINE_LEARNING_URL=http://immich-ml:3003

Label=homepage.name=Immich
Label=homepage.group=Content
Label=homepage.icon=immich
Label=homepage.href=https://photos.hemati.com
Label="homepage.description=Photos & Videos"
[Service]
TimeoutStartSec=300
Restart=always

[Install]
WantedBy=default.target
