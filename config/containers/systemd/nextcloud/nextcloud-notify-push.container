[Unit]
Description=Nextcloud Notify Push Container
After=network-online.target nextcloud.service nextcloud-redis.service nextcloud-db.service
Requires=nextcloud.service nextcloud-redis.service nextcloud-db.service

[Container]
ContainerName=nextcloud-notify-push
EnvironmentFile=%h/.local/share/nextcloud-notify-push/.env
Network=homelab.network
Image=ghcr.io/nextcloud/notify_push:latest
AutoUpdate=registry
SecurityLabelDisable=true

Environment=PORT=7867
Environment=NEXTCLOUD_URL=http://nextcloud
Environment=DATABASE_PREFIX=oc_
Environment=REDIS_URL=redis://nextcloud-redis:6379

[Install]
WantedBy=default.target
