[Unit]
Description=Paperless-ngx Container
After=network-online.target

[Container]
ContainerName=paperless
Image=ghcr.io/paperless-ngx/paperless-ngx:latest
Network=homelab.network
Environment=PAPERLESS_REDIS=redis://paperless-redis:6379
EnvironmentFile=%h/.local/share/paperless/.env
Volume=%h/.local/share/paperless/data:/usr/src/paperless/data:Z
Volume=%h/.local/share/paperless/media:/usr/src/paperless/media:Z
Volume=%h/.local/share/paperless/consume:/usr/src/paperless/consume:Z
AutoUpdate=registry
HealthCmd=curl -fsS -o /dev/null http://localhost:8000/ || exit 1
AddHost=host.containers.internal:host-gateway

Label=homepage.name=Paperless
Label=homepage.group=Content
Label=homepage.icon=paperless-ngx
Label=homepage.href=https://paperless.hemati.com
Label=homepage.description=Document Archive

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
