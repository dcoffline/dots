[Unit]
Description=Immich-DB
After=network-online.target

[Container]
Network=homelab.network
ContainerName=immich-db
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
AutoUpdate=registry

# DB stays on the SSD for performance
Volume=%h/.local/share/immich/db:/var/lib/postgresql/data:Z
EnvironmentFile=%h/.secrets
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS='--auth-host=scram-sha-256'
