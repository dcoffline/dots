[Unit]
Description=openwispr transcription engine
After=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/bin:/home/linuxbrew/.linuxbrew/bin:/bin:/usr/local/bin"
ExecStart=%h/.local/bin/openwispr engine
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
