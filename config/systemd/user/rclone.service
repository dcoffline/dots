[Unit]
Description=Rclone VFS Mounts Service
After=network-online.target
Wants=network-online.target
RequiresMountsFor=%h/.mnt/2T

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/just mount
ExecStop=/usr/bin/just unmount
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
