[Unit]
Description=openwispr hold-to-talk daemon
After=graphical-session.target
Wants=openwispr-engine.service
After=openwispr-engine.service
Wants=xdg-desktop-portal.service
After=xdg-desktop-portal.service


[Service]
Type=simple
ExecStart=%h/.local/bin/openwispr daemon --backend auto --trigger KEY_RIGHTALT
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
