[Unit]
Description=openwispr hold-to-talk daemon
After=graphical-session.target
Wants=openwispr-engine.service
After=openwispr-engine.service
# Support both GNOME and KDE (systemd only uses whichever is actually installed/running)
Wants=xdg-desktop-portal.service \
      xdg-desktop-portal-gnome.service \
      xdg-desktop-portal-kde.service
After=xdg-desktop-portal.service \
      xdg-desktop-portal-gnome.service \
      xdg-desktop-portal-kde.service

[Service]
Type=simple
ExecStart=%h/.local/bin/openwispr daemon --backend auto --trigger <Super>z --evdev-key z
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
