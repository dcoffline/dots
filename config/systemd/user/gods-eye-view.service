[Unit]
Description=God's Eye View Geospatial Console
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/src/projects/gods-eye-view
Environment="PATH=/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/usr/local/bin:/usr/bin:/bin:%h/.local/bin"
Environment=NODE_ENV=development
Environment=HOST=0.0.0.0
Environment=PORT=4173
ExecStart=/home/linuxbrew/.linuxbrew/bin/npm run dev
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
