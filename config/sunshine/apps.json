{
    "apps": [
        {
            "auto-detach": true,
            "cmd": "",
            "detached": [
                "/usr/bin/bazzite-steam-bpm"
            ],
            "exclude-global-prep-cmd": false,
            "exit-timeout": 3,
            "image-path": "steam.png",
            "name": "Big Picture Mode",
            "output": "$(HOME)/.config/sunshine/app-bigpic.log",
            "prep-cmd": [
                {
                    "do": "monctl 1920x1080 59.963",
                    "undo": ""
                },
                {
                    "do": "touchup",
                    "undo": "touchup off"
                },
                {
                    "do": "loginctl unlock-session $(loginctl show-user $USER -p Display --value)",
                    "undo": ""
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "",
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "desktop.png",
            "name": "Desktop",
            "output": "$(HOME)/.config/sunshine/app-desktop.log",
            "prep-cmd": [
                {
                    "do": "monctl 2560x1440 120",
                    "undo": ""
                },
                {
                    "do": "natscroll off",
                    "undo": ""
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "/home/eric/.config/sunshine/covers/igdb_288397.png",
            "name": "Low Resolution",
            "output": "/var/home/eric/.config/sunshine/app-lowres.log",
            "prep-cmd": [
                {
                    "do": "monctl 1920x1080 59.963",
                    "undo": ""
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "$(HOME)/.config/sunshine/covers/macbook.png",
            "name": "MacPro",
            "output": "$(HOME)/.config/sunshine/app-laptop.log",
            "prep-cmd": [
                {
                    "do": "monctl 1680x1050 119.891",
                    "undo": ""
                },
                {
                    "do": "natscroll off",
                    "undo": ""
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "$(HOME)/.config/sunshine/covers/ipad.png",
            "name": "Tablet",
            "output": "$(HOME)/.config/sunshine/app-tablet.log",
            "prep-cmd": [
                {
                    "do": "monctl 1280x800 119.909",
                    "undo": ""
                },
                {
                    "do": "touchup",
                    "undo": "touchup off"
                },
                {
                    "do": "natscroll",
                    "undo": ""
                },
                {
                    "do": "loginctl unlock-session $(loginctl show-user $USER -p Display --value)",
                    "undo": ""
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "$(HOME)/.config/sunshine/covers/ultra.png",
            "name": "Ultrawide",
            "output": "$(HOME)/.config/sunshine/app-ultra.log",
            "prep-cmd": [
                {
                    "do": "monctl 3440x1440 119.945",
                    "undo": ""
                },
                {
                    "do": "natscroll",
                    "undo": ""
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "cmd": "",
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "$(HOME)/.config/sunshine/covers/iphone.png",
            "name": "Wide Phone",
            "output": "$(HOME)/.config/sunshine/app-phone.log",
            "prep-cmd": [
                {
                    "do": "monctl 1560x720 60",
                    "undo": ""
                },
                {
                    "do": "touchup",
                    "undo": "touchup off"
                },
                {
                    "do": "loginctl unlock-session $(loginctl show-user $USER -p Display --value)",
                    "undo": ""
                }
            ],
            "wait-all": true
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin:/opt/homebrew/bin:/usr/local/bin"
    }
}